<!doctype html>
<html lang="{{ home.locale }}">
<head>
  <meta charset="utf-8">
  <title>Pierrick's Sunday Kitchen</title>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
</head>
<body>
  <h1>Pierrick's Sunday Kitchen</h1>
  <nav>
    <ul>
      {% for category in home.categories %}
        <li><a href="/{{ home.locale }}/categories/{{ category.slug }}.html">{{ category.name }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  <div x-data="categoryBrowse('{{ home.locale }}', null)" x-init="load()">
    <input type="search" x-model="query" placeholder="Search all recipes...">
    <ul>
      <template x-for="recipe in filtered" :key="recipe.recipeId">
        <li>
          <a :href="'/' + locale + '/recipes/' + recipe.slug + '.html'" x-text="recipe.title"></a>
        </li>
      </template>
    </ul>
  </div>
  <script src="/assets/browse.js"></script>
</body>
</html>
