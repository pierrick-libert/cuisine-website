{% import "locale-switcher.njk" as switcher %}
<!doctype html>
<html lang="{{ category.locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ category.name }} — Pierrick's Sunday Kitchen</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,600;0,700&family=Karla:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/style.css">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
</head>
<body>
  <div class="page" x-data="categoryBrowse('{{ category.locale }}', '{{ category.slug }}')" x-init="load()">
    <div class="topbar">
      <a class="brand" href="/{{ category.locale }}/index.html">Pierrick's Sunday Kitchen</a>
      {{ switcher.localeSwitcher(category.locales, category.locale) }}
    </div>

    <div class="page-header">
      <div>
        <a class="back-link" href="/{{ category.locale }}/index.html">← All categories</a>
        <div class="eyebrow">Category</div>
        <h1>{{ category.name }}</h1>
      </div>
      <div class="search-box">
        <input type="search" x-model="query" placeholder="Search {{ category.name | lower }}…">
      </div>
    </div>

    {% if category.categories.length %}
    <div class="category-nav">
      {% for cat in category.categories %}
        <a class="category-pill{% if cat.slug == category.slug %} active{% endif %}" href="/{{ category.locale }}/categories/{{ cat.slug }}.html">{{ cat.name }}</a>
      {% endfor %}
    </div>
    {% endif %}

    <div class="recipe-grid">
      <template x-for="recipe in filtered" :key="recipe.recipeId">
        <a class="recipe-card" :href="'/' + locale + '/recipes/' + recipe.slug + '.html'">
          <template x-if="recipe.coverImageUrl">
            <img :src="recipe.coverImageUrl" :alt="recipe.title">
          </template>
          <h2 x-text="recipe.title"></h2>
        </a>
      </template>
    </div>
    <p class="empty-state" x-show="filtered.length === 0">No recipes match yet.</p>
  </div>
  <script src="/assets/browse.js"></script>
</body>
</html>
