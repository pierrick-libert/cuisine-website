<!doctype html>
<html lang="{{ recipe.locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ recipe.title }}</title>
</head>
<body>
  <h1>{{ recipe.title }}</h1>
  {% if recipe.description %}<p>{{ recipe.description }}</p>{% endif %}
  <section class="ingredients">
    {% for group in recipe.ingredientGroups %}
      {% if group.name %}<h2>{{ group.name }}</h2>{% endif %}
      <ul>
        {% for line in group.lines %}<li>{{ line.text }}</li>{% endfor %}
      </ul>
    {% endfor %}
  </section>
  <section class="steps">
    <ol>
      {% for stepHtml in recipe.stepsHtml %}<li>{{ stepHtml | safe }}</li>{% endfor %}
    </ol>
  </section>
</body>
</html>
