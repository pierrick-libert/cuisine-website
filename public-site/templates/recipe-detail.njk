{% import "locale-switcher.njk" as switcher %}
<!doctype html>
<html lang="{{ recipe.locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ recipe.title }} — Pierrick's Sunday Kitchen</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,500;0,600;0,700;1,400&family=Karla:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/style.css">
  {% if recipe.baseServings %}
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
  {% endif %}
</head>
<body>
  <div class="page">
    <div class="topbar">
      <a class="brand" href="/{{ recipe.locale }}/index.html">Pierrick's Sunday Kitchen</a>
      {{ switcher.localeSwitcher(recipe.locales, recipe.locale) }}
    </div>

    <div class="hero">
      <div class="hero-meta">
        {% if recipe.category %}<a class="badge" href="/{{ recipe.locale }}/categories/{{ recipe.category.slug }}.html">{{ recipe.category.name }}</a>{% endif %}
        {% if recipe.prepMinutes or recipe.cookMinutes %}
        <span class="meta-item">
          {% if recipe.prepMinutes %}Prep {{ recipe.prepMinutes }} min{% endif %}
          {% if recipe.prepMinutes and recipe.cookMinutes %}&nbsp;·&nbsp;{% endif %}
          {% if recipe.cookMinutes %}Bake {{ recipe.cookMinutes }} min{% endif %}
        </span>
        {% endif %}
        {% if recipe.baseServings %}<span class="meta-item">Serves {{ recipe.baseServings }}</span>{% endif %}
      </div>
      <h1>{{ recipe.title }}</h1>
      {% if recipe.description %}<p class="description">{{ recipe.description }}</p>{% endif %}
    </div>

    {% if recipe.coverImageUrl %}
    <div class="hero-image">
      <img src="{{ recipe.coverImageUrl }}" alt="{{ recipe.title }}">
    </div>
    {% endif %}

    <div class="recipe-body">
      {% if recipe.ingredientGroups.length %}
      <div class="ingredients-card">
        <h2>Ingredients</h2>
        {% if recipe.baseServings %}
        <div x-data="recipeDetail({{ recipe.ingredientGroups | dump }}, {{ recipe.baseServings }})">
          <div class="servings-stepper">
            <span class="meta-item">Servings</span>
            <button type="button" aria-label="Decrease servings" @click="dec()">&minus;</button>
            <span x-text="servings"></span>
            <button type="button" aria-label="Increase servings" @click="inc()">+</button>
          </div>
          <template x-for="group in groups" :key="group.name">
            <div>
              <div class="group-name" x-show="group.name" x-text="group.name"></div>
              <ul>
                <template x-for="line in group.lines" :key="line.name">
                  <li>
                    <span x-text="scaledQuantity(line) + (line.unit ? ' ' + line.unit : '') + ' ' + line.name"></span>
                    <template x-if="line.approxEquivalent">
                      <div class="approx" x-text="'≈ ' + scaledApprox(line) + ' ' + line.approxEquivalent.unit"></div>
                    </template>
                  </li>
                </template>
              </ul>
            </div>
          </template>
        </div>
        {% else %}
        {% for group in recipe.ingredientGroups %}
          {% if group.name %}<div class="group-name">{{ group.name }}</div>{% endif %}
          <ul>
            {% for line in group.lines %}
              <li>
                {{ line.quantity }}{% if line.unit %} {{ line.unit }}{% endif %} {{ line.name }}
                {% if line.approxEquivalent %}<div class="approx">≈ {{ line.approxEquivalent.quantity }} {{ line.approxEquivalent.unit }}</div>{% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
        {% endif %}
      </div>
      {% endif %}

      <div class="steps">
        <h2>Method</h2>
        <ol>
          {% for stepHtml in recipe.stepsHtml %}<li>{{ stepHtml | safe }}</li>{% endfor %}
        </ol>
      </div>
    </div>
  </div>
  {% if recipe.baseServings %}
  <script src="/assets/recipe.js"></script>
  {% endif %}
</body>
</html>
