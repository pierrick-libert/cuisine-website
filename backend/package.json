{
  "name": "@sunday-kitchen/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=.env.local --env-file=.env.example watch src/local-server.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "npm run test:unit && npm run test:integration",
    "db:local:up": "docker run -d --rm --name sunday-kitchen-ddb-local -p 8000:8000 amazon/dynamodb-local",
    "db:local:down": "docker rm -f sunday-kitchen-ddb-local",
    "create-table:local": "tsx --env-file-if-exists=.env.local --env-file=.env.example src/lib/create-table.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.9.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
