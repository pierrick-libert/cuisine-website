{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ".." (the repo root), not "." — 004-publish-pipeline-and's render-recipe.ts imports
    // ../../../public-site/src/* (plan.md's deliberate cross-package layout; public-site/ is
    // not a published package, just a sibling source tree), which otherwise falls outside
    // backend's own rootDir.
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["src", "tests", "../public-site/src"]
}
